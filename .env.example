# Application Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=talenthub-super-secret-key-change-in-prod-2026
JWT_EXPIRES_IN=24h

# Database Configuration
# Leave DATABASE_URL empty to use zero-config embedded PostgreSQL (PGlite)
# Or provide standard PostgreSQL connection string:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/talenthub

# File & Object Store
STORAGE_PATH=./uploads/offers
CLIENT_URL=http://localhost:5173

